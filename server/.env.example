# Required in production (Railway): app must send X-Travel-Id-Token
APP_PROXY_TOKEN=change-me-to-a-long-random-string
PORT=8787

# RailRadar — up to 6 keys. When one hits rate/quota limit, proxy loops to the next.
RAILRADAR_API_KEY=rg_key_1
RAILRADAR_API_KEY_2=rg_key_2
RAILRADAR_API_KEY_3=rg_key_3
RAILRADAR_API_KEY_4=rg_key_4
RAILRADAR_API_KEY_5=rg_key_5
RAILRADAR_API_KEY_6=rg_key_6
# Legacy alias for key 2 (still supported):
# RAILRADAR_API_KEY_BACKUP=rg_key_2
# Or comma-separated:
# RAILRADAR_API_KEYS=rg_1,rg_2,rg_3,rg_4,rg_5,rg_6

# Aviationstack — up to 6 keys (same rotate-on-limit loop) — optional fallback
AVIATIONSTACK_API_KEY=flight_key_1
# AVIATIONSTACK_API_KEY_2=flight_key_2
# AVIATIONSTACK_API_KEYS=key1,key2,key3

# Cirium Sky (preferred) — secret is the static Authorization token
# identifier → CIRIUM_IDENTIFIER (optional for Sky)
# secret     → CIRIUM_SECRET
# base url   → CIRIUM_BASE_URL  (no trailing slash)
CIRIUM_IDENTIFIER=your_identifier
CIRIUM_SECRET=your_static_authorization_token
CIRIUM_BASE_URL=https://api.sky.cirium.com
# Legacy FlightStats Flex: CIRIUM_BASE_URL=https://api.flightstats.com
# Legacy aliases still work: CIRIUM_APP_ID / CIRIUM_APP_KEY

# Baidu Unlimited-OCR (optional GPU server)
# https://github.com/baidu/Unlimited-OCR
# Point at an OpenAI-compatible SGLang / vLLM host (no trailing slash).
# UNLIMITED_OCR_URL=http://127.0.0.1:10000
# UNLIMITED_OCR_MODEL=Unlimited-OCR
# UNLIMITED_OCR_API_KEY=

# GEMINI_API_KEY=   # server-only — never commit real keys
# GEMINI_MODEL=gemini-flash-latest
